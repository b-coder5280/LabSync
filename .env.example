NEXT_PUBLIC_CONTACT_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Kakao: off until the founder configures all server values; never prefix secrets with NEXT_PUBLIC.
KAKAO_LOGIN_ENABLED=false
APP_ORIGIN=https://labsync-pink.vercel.app
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_COOKIE_SECRET=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional search verification tokens (public).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Off until property ownership, privacy notice and collection settings are approved.
NEXT_PUBLIC_PRIVACY_APPROVED=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Local policy review only. Vercel deployments always hide unapproved drafts.
LEGAL_DRAFT_PREVIEW=false
# Default off. Live intake requires approved policy, HTTPS origin and retention settings.
INQUIRY_MODE=disabled
INQUIRY_ORIGIN=http://localhost:3100
INQUIRY_COOKIE_SECRET=
# Only set for isolated local tests, never Vercel:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9095

# Operations uses existing Firebase Auth and an isolated Firestore namespace.
OPERATIONS_MODE=disabled
OPERATIONS_ORIGIN=
# Local emulator only, used with the loopback emulator hosts above:
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9095
LEGAL_APPROVED=false
INQUIRY_RETENTION_DAYS=

# Optional LINE login; enable only after channel, callback and policy approval.
LINE_LOGIN_ENABLED=false
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_COOKIE_SECRET=
